<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
<ImageView android:id="@+id/bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:src="@drawable/bg_dark"
    android:scaleType="fitXY" />
<LinearLayout android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:orientation="horizontal"
    android:layout_weight="1"
    android:gravity="center_vertical">
<LinearLayout android:id="@+id/clock_area"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">
<TextClock android:id="@+id/clock"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fontFamily="@font/f_outfit_c"
    android:format12Hour="HH:mm"
    android:format24Hour="HH:mm"
    android:includeFontPadding="false"
    android:textColor="#FFFFFF"
    android:textSize="74sp"
    android:maxLines="1" />
</LinearLayout>
<TextView android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
<LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="end">
<TextClock android:id="@+id/date"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fontFamily="@font/f_outfit_t"
    android:format12Hour="EEEE"
    android:format24Hour="EEEE"
    android:includeFontPadding="false"
    android:textColor="#C9D1DC"
    android:textSize="13sp"
    android:maxLines="1" />
<TextClock android:id="@+id/date2"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fontFamily="@font/f_outfit_t"
    android:format12Hour="d MMMM"
    android:format24Hour="d MMMM"
    android:includeFontPadding="false"
    android:textColor="#C9D1DC"
    android:textSize="13sp"
    android:maxLines="1" />
<LinearLayout android:id="@+id/city_row"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="end">
<ImageView android:id="@+id/pin"
    android:layout_width="13dp"
    android:layout_height="13dp"
    android:src="@drawable/pin" />
<TextView android:id="@+id/city"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fontFamily="@font/f_outfit_t"
    android:includeFontPadding="false"
    android:textColor="#FFFFFF"
    android:textSize="12sp"
    android:maxLines="1"
    android:layout_marginStart="3dp" />
</LinearLayout>
</LinearLayout>
</LinearLayout>
<ImageView android:id="@+id/divider" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="6dp" android:layout_marginBottom="6dp" android:scaleType="fitXY" android:src="@drawable/divider" />
<LinearLayout android:id="@+id/weather_area"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">
<ImageView android:id="@+id/now_icon"
    android:layout_width="32dp"
    android:layout_height="32dp"
    android:src="@drawable/w_partly" />
<TextView android:id="@+id/now_temp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fontFamily="@font/f_outfit_c"
    android:includeFontPadding="false"
    android:textColor="#FFFFFF"
    android:textSize="20sp"
    android:maxLines="1"
    android:layout_marginStart="6dp"
    android:text="--°" />
<TextView android:id="@+id/now_desc"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fontFamily="@font/f_outfit_t"
    android:includeFontPadding="false"
    android:textColor="#C9D1DC"
    android:textSize="13sp"
    android:maxLines="1"
    android:layout_marginStart="8dp" />
<TextView android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
<TextView android:id="@+id/extra"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fontFamily="@font/f_outfit_t"
    android:includeFontPadding="false"
    android:textColor="#C9D1DC"
    android:textSize="12sp"
    android:maxLines="1" />
</LinearLayout>
</LinearLayout>
</FrameLayout>
