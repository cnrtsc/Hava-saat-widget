<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
<ImageView android:id="@+id/bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/bg_none" />
<LinearLayout android:padding="6dp" android:id="@+id/clock_area"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center">
<ImageView android:id="@+id/clock_h"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" />
<ImageView android:id="@+id/clock_m"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" />
</LinearLayout>
</FrameLayout>
