<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
<ImageView android:id="@+id/bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/bg_none" />
<LinearLayout android:padding="14dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:orientation="horizontal"
    android:layout_weight="1">
<LinearLayout android:id="@+id/clock_area"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layout_weight="1"
    android:gravity="center_vertical">
<ImageView android:id="@+id/clock"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" />
<ImageView android:id="@+id/date"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp" />
</LinearLayout>
<LinearLayout android:id="@+id/weather_area"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical|end">
<LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">
<ViewFlipper android:id="@+id/icon_flip"
    android:layout_width="58dp"
    android:layout_height="58dp"
    android:autoStart="true"
    android:flipInterval="30000"
    android:inAnimation="@android:anim/fade_in"
    android:outAnimation="@android:anim/fade_out">
<ImageView android:id="@+id/now_icon"
    android:layout_width="58dp"
    android:layout_height="58dp"
    android:src="@drawable/r_partly" />
<ImageView android:id="@+id/now_icon2"
    android:layout_width="58dp"
    android:layout_height="58dp"
    android:src="@drawable/r_partly"
    android:translationX="2dp"
    android:translationY="-3dp" />
<ImageView android:id="@+id/now_icon3"
    android:layout_width="58dp"
    android:layout_height="58dp"
    android:src="@drawable/r_partly"
    android:translationY="-5dp" />
</ViewFlipper>
<ImageView android:id="@+id/now_temp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" />
</LinearLayout>
<TextView android:id="@+id/now_desc"
    android:shadowColor="#66000000"
    android:shadowDy="1"
    android:shadowRadius="5"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:includeFontPadding="false"
    android:textColor="#C9D1DC"
    android:textSize="12sp"
    android:maxLines="1" />
<TextView android:id="@+id/feels"
    android:shadowColor="#66000000"
    android:shadowDy="1"
    android:shadowRadius="5"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:includeFontPadding="false"
    android:textColor="#C9D1DC"
    android:textSize="11sp"
    android:maxLines="1" />
<LinearLayout android:id="@+id/city_row"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="end">
<ImageView android:id="@+id/pin"
    android:layout_width="13dp"
    android:layout_height="13dp"
    android:src="@drawable/pin" />
<TextView android:id="@+id/city"
    android:shadowColor="#66000000"
    android:shadowDy="1"
    android:shadowRadius="5"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:includeFontPadding="false"
    android:textColor="#FFFFFF"
    android:textSize="12sp"
    android:maxLines="1"
    android:layout_marginStart="3dp" />
</LinearLayout>
</LinearLayout>
</LinearLayout>
<ImageView android:id="@+id/divider" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="6dp" android:layout_marginBottom="6dp" android:scaleType="fitXY" android:src="@drawable/divider" />
<LinearLayout android:id="@+id/days_area"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">
<LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_weight="1"
    android:gravity="center">
<TextView android:id="@+id/d1_name"
    android:shadowColor="#66000000"
    android:shadowDy="1"
    android:shadowRadius="5"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:includeFontPadding="false"
    android:textColor="#FFFFFF"
    android:textSize="13sp"
    android:maxLines="1" />
<ImageView android:id="@+id/d1_icon"
    android:layout_width="26dp"
    android:layout_height="26dp"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp" />
<TextView android:id="@+id/d1_temp"
    android:shadowColor="#66000000"
    android:shadowDy="1"
    android:shadowRadius="5"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:includeFontPadding="false"
    android:textColor="#C9D1DC"
    android:textSize="13sp"
    android:maxLines="1" />
</LinearLayout>
<LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_weight="1"
    android:gravity="center">
<TextView android:id="@+id/d2_name"
    android:shadowColor="#66000000"
    android:shadowDy="1"
    android:shadowRadius="5"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:includeFontPadding="false"
    android:textColor="#FFFFFF"
    android:textSize="13sp"
    android:maxLines="1" />
<ImageView android:id="@+id/d2_icon"
    android:layout_width="26dp"
    android:layout_height="26dp"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp" />
<TextView android:id="@+id/d2_temp"
    android:shadowColor="#66000000"
    android:shadowDy="1"
    android:shadowRadius="5"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:includeFontPadding="false"
    android:textColor="#C9D1DC"
    android:textSize="13sp"
    android:maxLines="1" />
</LinearLayout>
<LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_weight="1"
    android:gravity="center">
<TextView android:id="@+id/d3_name"
    android:shadowColor="#66000000"
    android:shadowDy="1"
    android:shadowRadius="5"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:includeFontPadding="false"
    android:textColor="#FFFFFF"
    android:textSize="13sp"
    android:maxLines="1" />
<ImageView android:id="@+id/d3_icon"
    android:layout_width="26dp"
    android:layout_height="26dp"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp" />
<TextView android:id="@+id/d3_temp"
    android:shadowColor="#66000000"
    android:shadowDy="1"
    android:shadowRadius="5"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:includeFontPadding="false"
    android:textColor="#C9D1DC"
    android:textSize="13sp"
    android:maxLines="1" />
</LinearLayout>
</LinearLayout>
</LinearLayout>
</FrameLayout>
