<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
<ImageView android:id="@+id/bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:src="@drawable/bg_dark"
    android:scaleType="fitXY" />
<LinearLayout android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center">
<LinearLayout android:id="@+id/city_row"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center">
<ImageView android:id="@+id/pin"
    android:layout_width="14dp"
    android:layout_height="14dp"
    android:src="@drawable/pin" />
<TextView android:id="@+id/city"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fontFamily="@font/f_outfit_t"
    android:includeFontPadding="false"
    android:textColor="#FFFFFF"
    android:textSize="13sp"
    android:maxLines="1"
    android:layout_marginStart="3dp" />
</LinearLayout>
<ImageView android:id="@+id/now_icon"
    android:layout_width="56dp"
    android:layout_height="56dp"
    android:src="@drawable/w_partly"
    android:layout_marginTop="2dp" />
<LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">
<LinearLayout android:id="@+id/clock_area"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">
<TextClock android:id="@+id/clock"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fontFamily="@font/f_outfit_c"
    android:format12Hour="HH:mm"
    android:format24Hour="HH:mm"
    android:includeFontPadding="false"
    android:textColor="#FFFFFF"
    android:textSize="46sp"
    android:maxLines="1" />
</LinearLayout>
<ImageView android:id="@+id/vdiv" android:layout_width="1dp" android:layout_height="38dp" android:layout_marginStart="14dp" android:layout_marginEnd="14dp" android:scaleType="fitXY" android:src="@drawable/divider" />
<LinearLayout android:id="@+id/weather_area"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">
<TextView android:id="@+id/now_temp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fontFamily="@font/f_outfit_c"
    android:includeFontPadding="false"
    android:textColor="#FFFFFF"
    android:textSize="26sp"
    android:maxLines="1"
    android:text="--°" />
<TextView android:id="@+id/hl"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fontFamily="@font/f_outfit_t"
    android:includeFontPadding="false"
    android:textColor="#C9D1DC"
    android:textSize="12sp"
    android:maxLines="1" />
</LinearLayout>
</LinearLayout>
<LinearLayout android:id="@+id/days_area"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal">
<TextClock android:id="@+id/date"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fontFamily="@font/f_outfit_t"
    android:format12Hour="EEEE, d MMMM"
    android:format24Hour="EEEE, d MMMM"
    android:includeFontPadding="false"
    android:textColor="#C9D1DC"
    android:textSize="12sp"
    android:maxLines="1" />
<TextView android:id="@+id/sep"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fontFamily="@font/f_outfit_t"
    android:includeFontPadding="false"
    android:textColor="#C9D1DC"
    android:textSize="12sp"
    android:maxLines="1"
    android:text="  ·  " />
<TextView android:id="@+id/now_desc"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fontFamily="@font/f_outfit_t"
    android:includeFontPadding="false"
    android:textColor="#C9D1DC"
    android:textSize="12sp"
    android:maxLines="1" />
</LinearLayout>
</LinearLayout>
</FrameLayout>
