<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
<ImageView android:id="@+id/dial" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
<LinearLayout android:id="@+id/weather_area"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="18dp">
<ImageView android:id="@+id/now_temp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" />
<TextView android:id="@+id/hl"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:includeFontPadding="false"
    android:textColor="#FFFFFF"
    android:textSize="11sp"
    android:maxLines="1" />
<ViewFlipper android:id="@+id/icon_flip"
    android:layout_width="34dp"
    android:layout_height="34dp"
    android:autoStart="true"
    android:flipInterval="30000"
    android:inAnimation="@android:anim/fade_in"
    android:outAnimation="@android:anim/fade_out"
    android:layout_marginTop="2dp">
<ImageView android:id="@+id/now_icon"
    android:layout_width="34dp"
    android:layout_height="34dp"
    android:src="@drawable/r_partly" />
<ImageView android:id="@+id/now_icon2"
    android:layout_width="34dp"
    android:layout_height="34dp"
    android:src="@drawable/r_partly"
    android:translationX="2dp"
    android:translationY="-3dp" />
<ImageView android:id="@+id/now_icon3"
    android:layout_width="34dp"
    android:layout_height="34dp"
    android:src="@drawable/r_partly"
    android:translationY="-5dp" />
</ViewFlipper>
</LinearLayout>
</FrameLayout>
