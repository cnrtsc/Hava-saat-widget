<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
<ImageView android:id="@+id/bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:src="@drawable/bg_dark"
    android:scaleType="fitXY" />
<LinearLayout android:padding="14dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:orientation="horizontal"
    android:layout_weight="1">
<LinearLayout android:id="@+id/clock_area"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layout_weight="1"
    android:gravity="center_vertical">
<TextClock android:id="@+id/clock"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fontFamily="@font/f_grotesk_c"
    android:format12Hour="HH:mm"
    android:format24Hour="HH:mm"
    android:includeFontPadding="false"
    android:textColor="#FFFFFF"
    android:textSize="52sp"
    android:maxLines="1" />
<TextClock android:id="@+id/date"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fontFamily="@font/f_grotesk_t"
    android:format12Hour="EEEE, d MMMM"
    android:format24Hour="EEEE, d MMMM"
    android:includeFontPadding="false"
    android:textColor="#C9D1DC"
    android:textSize="14sp"
    android:maxLines="1"
    android:layout_marginTop="2dp" />
</LinearLayout>
<LinearLayout android:id="@+id/weather_area"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical|end">
<LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">
<ImageView android:id="@+id/now_icon"
    android:layout_width="58dp"
    android:layout_height="58dp"
    android:src="@drawable/w_partly" />
<TextView android:id="@+id/now_temp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fontFamily="@font/f_grotesk_c"
    android:includeFontPadding="false"
    android:textColor="#FFFFFF"
    android:textSize="34sp"
    android:maxLines="1"
    android:text="--°" />
</LinearLayout>
<TextView android:id="@+id/now_desc"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fontFamily="@font/f_grotesk_t"
    android:includeFontPadding="false"
    android:textColor="#C9D1DC"
    android:textSize="12sp"
    android:maxLines="1" />
<LinearLayout android:id="@+id/city_row"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="end">
<ImageView android:id="@+id/pin"
    android:layout_width="13dp"
    android:layout_height="13dp"
    android:src="@drawable/pin" />
<TextView android:id="@+id/city"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fontFamily="@font/f_grotesk_t"
    android:includeFontPadding="false"
    android:textColor="#FFFFFF"
    android:textSize="12sp"
    android:maxLines="1"
    android:layout_marginStart="3dp" />
</LinearLayout>
</LinearLayout>
</LinearLayout>
<ImageView android:id="@+id/divider" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="6dp" android:layout_marginBottom="6dp" android:scaleType="fitXY" android:src="@drawable/divider" />
<LinearLayout android:id="@+id/days_area"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">
<LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_weight="1"
    android:gravity="center">
<TextView android:id="@+id/d1_name"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fontFamily="@font/f_grotesk_t"
    android:includeFontPadding="false"
    android:textColor="#FFFFFF"
    android:textSize="13sp"
    android:maxLines="1" />
<ImageView android:id="@+id/d1_icon"
    android:layout_width="26dp"
    android:layout_height="26dp"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp" />
<TextView android:id="@+id/d1_temp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fontFamily="@font/f_grotesk_t"
    android:includeFontPadding="false"
    android:textColor="#C9D1DC"
    android:textSize="13sp"
    android:maxLines="1" />
</LinearLayout>
<LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_weight="1"
    android:gravity="center">
<TextView android:id="@+id/d2_name"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fontFamily="@font/f_grotesk_t"
    android:includeFontPadding="false"
    android:textColor="#FFFFFF"
    android:textSize="13sp"
    android:maxLines="1" />
<ImageView android:id="@+id/d2_icon"
    android:layout_width="26dp"
    android:layout_height="26dp"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp" />
<TextView android:id="@+id/d2_temp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fontFamily="@font/f_grotesk_t"
    android:includeFontPadding="false"
    android:textColor="#C9D1DC"
    android:textSize="13sp"
    android:maxLines="1" />
</LinearLayout>
<LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_weight="1"
    android:gravity="center">
<TextView android:id="@+id/d3_name"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fontFamily="@font/f_grotesk_t"
    android:includeFontPadding="false"
    android:textColor="#FFFFFF"
    android:textSize="13sp"
    android:maxLines="1" />
<ImageView android:id="@+id/d3_icon"
    android:layout_width="26dp"
    android:layout_height="26dp"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp" />
<TextView android:id="@+id/d3_temp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fontFamily="@font/f_grotesk_t"
    android:includeFontPadding="false"
    android:textColor="#C9D1DC"
    android:textSize="13sp"
    android:maxLines="1" />
</LinearLayout>
</LinearLayout>
</LinearLayout>
</FrameLayout>
