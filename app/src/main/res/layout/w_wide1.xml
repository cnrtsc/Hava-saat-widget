<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
<ImageView android:id="@+id/bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/bg_none" />
<LinearLayout android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center">
<LinearLayout android:id="@+id/city_row"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center">
<ImageView android:id="@+id/pin"
    android:layout_width="14dp"
    android:layout_height="14dp"
    android:src="@drawable/pin" />
<TextView android:id="@+id/city"
    android:shadowColor="#66000000"
    android:shadowDy="1"
    android:shadowRadius="5"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:includeFontPadding="false"
    android:textColor="#FFFFFF"
    android:textSize="13sp"
    android:maxLines="1"
    android:layout_marginStart="3dp" />
</LinearLayout>
<ViewFlipper android:id="@+id/icon_flip"
    android:layout_width="56dp"
    android:layout_height="56dp"
    android:autoStart="true"
    android:flipInterval="30000"
    android:inAnimation="@android:anim/fade_in"
    android:outAnimation="@android:anim/fade_out">
<ImageView android:id="@+id/now_icon"
    android:layout_width="56dp"
    android:layout_height="56dp"
    android:src="@drawable/r_partly" />
<ImageView android:id="@+id/now_icon2"
    android:layout_width="56dp"
    android:layout_height="56dp"
    android:src="@drawable/r_partly"
    android:translationX="2dp"
    android:translationY="-3dp" />
<ImageView android:id="@+id/now_icon3"
    android:layout_width="56dp"
    android:layout_height="56dp"
    android:src="@drawable/r_partly"
    android:translationY="-5dp" />
</ViewFlipper>
<LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">
<LinearLayout android:id="@+id/clock_area"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">
<ImageView android:id="@+id/clock"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" />
</LinearLayout>
<ImageView android:id="@+id/vdiv" android:layout_width="1dp" android:layout_height="40dp" android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginTop="4dp" android:layout_marginBottom="4dp" android:scaleType="fitXY" android:src="@drawable/divider" />
<LinearLayout android:id="@+id/weather_area"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">
<ImageView android:id="@+id/now_temp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" />
<TextView android:id="@+id/hl"
    android:shadowColor="#66000000"
    android:shadowDy="1"
    android:shadowRadius="5"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:includeFontPadding="false"
    android:textColor="#C9D1DC"
    android:textSize="12sp"
    android:maxLines="1" />
<TextView android:id="@+id/feels"
    android:shadowColor="#66000000"
    android:shadowDy="1"
    android:shadowRadius="5"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:includeFontPadding="false"
    android:textColor="#C9D1DC"
    android:textSize="11sp"
    android:maxLines="1" />
</LinearLayout>
</LinearLayout>
<LinearLayout android:id="@+id/days_area"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginTop="4dp">
<ImageView android:id="@+id/date"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" />
<TextView android:id="@+id/sep"
    android:shadowColor="#66000000"
    android:shadowDy="1"
    android:shadowRadius="5"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:includeFontPadding="false"
    android:textColor="#C9D1DC"
    android:textSize="12sp"
    android:maxLines="1"
    android:text="  ·  " />
<TextView android:id="@+id/now_desc"
    android:shadowColor="#66000000"
    android:shadowDy="1"
    android:shadowRadius="5"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:includeFontPadding="false"
    android:textColor="#C9D1DC"
    android:textSize="12sp"
    android:maxLines="1" />
</LinearLayout>
</LinearLayout>
</FrameLayout>
