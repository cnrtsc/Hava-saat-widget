<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
<ImageView android:id="@+id/bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:src="@drawable/bg_dark"
    android:scaleType="fitXY" />
<LinearLayout android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:orientation="horizontal"
    android:layout_weight="1">
<LinearLayout android:id="@+id/clock_area"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layout_weight="1.25"
    android:gravity="center_vertical">
<LinearLayout android:id="@+id/city_row"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="start">
<ImageView android:id="@+id/pin"
    android:layout_width="16dp"
    android:layout_height="16dp"
    android:src="@drawable/pin" />
<TextView android:id="@+id/city"
    android:shadowColor="#80000000"
    android:shadowDy="1"
    android:shadowRadius="6"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fontFamily="@font/f_grotesk_t"
    android:includeFontPadding="false"
    android:textColor="#FFFFFF"
    android:textSize="15sp"
    android:maxLines="1"
    android:layout_marginStart="3dp" />
</LinearLayout>
<TextClock android:id="@+id/date"
    android:shadowColor="#80000000"
    android:shadowDy="1"
    android:shadowRadius="6"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fontFamily="@font/f_grotesk_t"
    android:format12Hour="d MMMM EEEE"
    android:format24Hour="d MMMM EEEE"
    android:includeFontPadding="false"
    android:textColor="#C9D1DC"
    android:textSize="12sp"
    android:maxLines="1"
    android:layout_marginTop="2dp" />
<TextClock android:id="@+id/clock"
    android:shadowColor="#80000000"
    android:shadowDy="1"
    android:shadowRadius="6"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fontFamily="@font/f_grotesk_c"
    android:format12Hour="HH:mm"
    android:format24Hour="HH:mm"
    android:includeFontPadding="false"
    android:textColor="#FFFFFF"
    android:textSize="42sp"
    android:maxLines="1"
    android:layout_marginTop="2dp" />
</LinearLayout>
