<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
<ImageView android:id="@+id/bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:src="@drawable/bg_dark"
    android:scaleType="fitXY" />
<LinearLayout android:padding="10dp" android:id="@+id/weather_area"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center">
<LinearLayout android:id="@+id/city_row"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center">
<ImageView android:id="@+id/pin"
    android:layout_width="13dp"
    android:layout_height="13dp"
    android:src="@drawable/pin" />
<TextView android:id="@+id/city"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fontFamily="@font/f_outfit_t"
    android:includeFontPadding="false"
    android:textColor="#FFFFFF"
    android:textSize="12sp"
    android:maxLines="1"
    android:layout_marginStart="3dp" />
</LinearLayout>
<ImageView android:id="@+id/now_icon"
    android:layout_width="58dp"
    android:layout_height="58dp"
    android:src="@drawable/w_partly" />
<TextView android:id="@+id/now_temp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fontFamily="@font/f_outfit_c"
    android:includeFontPadding="false"
    android:textColor="#FFFFFF"
    android:textSize="30sp"
    android:maxLines="1"
    android:text="--°" />
<LinearLayout android:id="@+id/clock_area"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:layout_marginTop="2dp">
<TextClock android:id="@+id/clock"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fontFamily="@font/f_outfit_c"
    android:format12Hour="HH:mm"
    android:format24Hour="HH:mm"
    android:includeFontPadding="false"
    android:textColor="#FFFFFF"
    android:textSize="18sp"
    android:maxLines="1" />
<TextClock android:id="@+id/date"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fontFamily="@font/f_outfit_t"
    android:format12Hour="EEE, d MMM"
    android:format24Hour="EEE, d MMM"
    android:includeFontPadding="false"
    android:textColor="#C9D1DC"
    android:textSize="11sp"
    android:maxLines="1" />
</LinearLayout>
</LinearLayout>
</FrameLayout>
