<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
<ViewFlipper android:id="@+id/anim" android:layout_width="match_parent" android:layout_height="match_parent"
    android:autoStart="true" android:flipInterval="150">
    <ImageView android:id="@+id/af0" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
    <ImageView android:id="@+id/af1" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
    <ImageView android:id="@+id/af2" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
    <ImageView android:id="@+id/af3" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
    <ImageView android:id="@+id/af4" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
    <ImageView android:id="@+id/af5" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
    <ImageView android:id="@+id/af6" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
    <ImageView android:id="@+id/af7" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
    <ImageView android:id="@+id/af8" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
    <ImageView android:id="@+id/af9" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
    <ImageView android:id="@+id/af10" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
    <ImageView android:id="@+id/af11" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
</ViewFlipper>
<ImageView android:id="@+id/dial" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">
<LinearLayout android:id="@+id/clock_area" android:layout_width="0dp" android:layout_height="match_parent" android:orientation="vertical" android:layout_weight="1" />
<LinearLayout android:id="@+id/weather_area" android:layout_width="0dp" android:layout_height="match_parent" android:orientation="vertical" android:layout_weight="1" />
</LinearLayout>
</FrameLayout>
