<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
<ImageView android:id="@+id/bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/bg_none" />
<LinearLayout android:padding="14dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">
<LinearLayout android:id="@+id/weather_area"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center">
<ImageView android:id="@+id/now_icon"
    android:layout_width="64dp"
    android:layout_height="64dp"
    android:src="@drawable/r_partly" />
<ImageView android:id="@+id/now_temp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" />
<TextView android:id="@+id/now_desc"
    android:shadowColor="#80000000"
    android:shadowDy="1"
    android:shadowRadius="6"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:includeFontPadding="false"
    android:textColor="#C9D1DC"
    android:textSize="12sp"
    android:maxLines="1" />
<TextView android:id="@+id/feels"
    android:shadowColor="#80000000"
    android:shadowDy="1"
    android:shadowRadius="6"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:includeFontPadding="false"
    android:textColor="#C9D1DC"
    android:textSize="11sp"
    android:maxLines="1" />
</LinearLayout>
<ImageView android:id="@+id/vdiv" android:layout_width="1dp" android:layout_height="match_parent" android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginTop="4dp" android:layout_marginBottom="4dp" android:scaleType="fitXY" android:src="@drawable/divider" />
<LinearLayout android:id="@+id/clock_area"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layout_weight="1"
    android:gravity="center_vertical">
<LinearLayout android:id="@+id/city_row"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="start">
<ImageView android:id="@+id/pin"
    android:layout_width="14dp"
    android:layout_height="14dp"
    android:src="@drawable/pin" />
<TextView android:id="@+id/city"
    android:shadowColor="#80000000"
    android:shadowDy="1"
    android:shadowRadius="6"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:includeFontPadding="false"
    android:textColor="#FFFFFF"
    android:textSize="13sp"
    android:maxLines="1"
    android:layout_marginStart="3dp" />
</LinearLayout>
<ImageView android:id="@+id/clock"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp" />
<ImageView android:id="@+id/date"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" />
<LinearLayout android:id="@+id/days_area"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginTop="8dp">
<LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginEnd="12dp">
<ImageView android:id="@+id/st_drop_i"
    android:layout_width="14dp"
    android:layout_height="14dp"
    android:src="@drawable/st_drop" />
<TextView android:id="@+id/hum"
    android:shadowColor="#80000000"
    android:shadowDy="1"
    android:shadowRadius="6"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:includeFontPadding="false"
    android:textColor="#FFFFFF"
    android:textSize="12sp"
    android:maxLines="1"
    android:layout_marginStart="4dp"
    android:text="--" />
</LinearLayout>
<LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginEnd="12dp">
<ImageView android:id="@+id/st_wind_i"
    android:layout_width="14dp"
    android:layout_height="14dp"
    android:src="@drawable/st_wind" />
<TextView android:id="@+id/wind"
    android:shadowColor="#80000000"
    android:shadowDy="1"
    android:shadowRadius="6"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:includeFontPadding="false"
    android:textColor="#FFFFFF"
    android:textSize="12sp"
    android:maxLines="1"
    android:layout_marginStart="4dp"
    android:text="--" />
</LinearLayout>
<LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginEnd="12dp">
<ImageView android:id="@+id/st_set_i"
    android:layout_width="14dp"
    android:layout_height="14dp"
    android:src="@drawable/st_set" />
<TextView android:id="@+id/sset"
    android:shadowColor="#80000000"
    android:shadowDy="1"
    android:shadowRadius="6"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:includeFontPadding="false"
    android:textColor="#FFFFFF"
    android:textSize="12sp"
    android:maxLines="1"
    android:layout_marginStart="4dp"
    android:text="--" />
</LinearLayout>
</LinearLayout>
</LinearLayout>
</LinearLayout>
</FrameLayout>
