<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
<ImageView android:id="@+id/bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:src="@drawable/bg_dark"
    android:scaleType="fitXY" />
<LinearLayout android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical">
<LinearLayout android:id="@+id/weather_area"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">
<ImageView android:id="@+id/now_icon"
    android:layout_width="42dp"
    android:layout_height="42dp"
    android:src="@drawable/w_partly" />
<LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginStart="6dp">
<TextView android:id="@+id/now_temp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fontFamily="@font/f_josefin_c"
    android:includeFontPadding="false"
    android:textColor="#FFFFFF"
    android:textSize="24sp"
    android:maxLines="1"
    android:text="--°" />
<LinearLayout android:id="@+id/city_row"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="start">
<ImageView android:id="@+id/pin"
    android:layout_width="12dp"
    android:layout_height="12dp"
    android:src="@drawable/pin" />
<TextView android:id="@+id/city"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fontFamily="@font/f_josefin_t"
    android:includeFontPadding="false"
    android:textColor="#FFFFFF"
    android:textSize="11sp"
    android:maxLines="1"
    android:layout_marginStart="3dp" />
</LinearLayout>
</LinearLayout>
</LinearLayout>
<TextView android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
<LinearLayout android:id="@+id/clock_area"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="end">
<TextClock android:id="@+id/clock"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fontFamily="@font/f_josefin_c"
    android:format12Hour="HH:mm"
    android:format24Hour="HH:mm"
    android:includeFontPadding="false"
    android:textColor="#FFFFFF"
    android:textSize="34sp"
    android:maxLines="1" />
<TextClock android:id="@+id/date"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fontFamily="@font/f_josefin_t"
    android:format12Hour="EEE, d MMM"
    android:format24Hour="EEE, d MMM"
    android:includeFontPadding="false"
    android:textColor="#C9D1DC"
    android:textSize="11sp"
    android:maxLines="1" />
</LinearLayout>
</LinearLayout>
</FrameLayout>
